---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { productsData } from '../data/products';
import { OrderCheckoutPage } from '../components/OrderCheckoutPage';

const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{
			'@type': 'ListItem',
			position: 1,
			name: 'Home',
			item: 'https://rizzercloud.web.id'
		},
		{
			'@type': 'ListItem',
			position: 2,
			name: 'Checkout Pesanan',
			item: 'https://rizzercloud.web.id/order'
		}
	]
};
---

<Layout 
	title="Form Pemesanan & Checkout Pesanan - RizzerShop"
	description="Konfigurasi pesanan VPS, RDP, atau Akun Premium Anda dan lanjutkan ke pembayaran via WhatsApp. Proses cepat, otomatis, dan bergaransi."
	tags={['Checkout VPS', 'Order RDP', 'Beli Akun Digital', 'Pemesanan RizzerShop']}
>
	<script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

	<Navbar />

	<main class="min-h-screen bg-black px-4 py-12 sm:px-6">
		<div class="mx-auto max-w-6xl">
			<OrderCheckoutPage client:load products={productsData} />
		</div>
	</main>

	<Footer />
</Layout>
