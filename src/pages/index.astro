	tags={['VPS Murah', 'RDP Botting', 'Akun Premium', 'ChatGPT Plus', 'Google Gemini Pro', 'RizzerShop', 'Cloud Server Indonesia']}
>
	<Navbar />
	<main>
		<Hero />
