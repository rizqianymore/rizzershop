---
import { ShoppingCart, MessageSquare, CheckCircle, Truck } from 'lucide-react';
---

<!-- How It Works Section -->
<section id="how-it-works" class="flex min-h-screen w-full flex-col justify-center bg-black px-4 py-12 sm:px-6 relative overflow-hidden">
	<div class="mx-auto w-full max-w-6xl relative z-10">
		<div class="text-center max-w-2xl mx-auto mb-12">
			<div class="inline-flex items-center gap-1.5 rounded-full border border-blue-500/30 bg-blue-950/40 px-2.5 py-0.5 text-[11px] font-medium text-blue-400 mb-2.5">
				<span>Cara Pemesanan</span>
			</div>
			<h2 class="text-2xl font-bold tracking-tight text-white sm:text-3xl bg-gradient-to-r from-white via-zinc-100 to-zinc-400 bg-clip-text text-transparent">Mudah, Cepat, & Otomatis</h2>
			<p class="mt-2.5 text-xs sm:text-sm text-zinc-400">Proses beli VPS, RDP, atau akun premium hanya butuh 4 langkah mudah.</p>
		</div>

		<div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
			{[
				{ icon: ShoppingCart, step: '01', title: 'Pilih Produk', desc: 'Pilih paket Cloud VPS, RDP, atau lisensi software yang Anda butuhkan.' },
				{ icon: MessageSquare, step: '02', title: 'Order via WhatsApp', desc: 'Klik tombol Beli untuk langsung terhubung dengan CS resmi kami.' },
				{ icon: CheckCircle, step: '03', title: 'Bayar & Verifikasi', desc: 'Selesaikan transaksi via QRIS, E-Wallet, atau transfer bank lokal.' },
				{ icon: Truck, step: '04', title: 'Aktivasi Instan', desc: 'Detail login server & kredensial akun langsung aktif dikirimkan.' },
			].map((item, i) => (
				<div data-astro-key={i} class="group relative flex flex-col justify-between rounded-xl border border-zinc-800/80 bg-zinc-950/70 p-6 backdrop-blur-sm transition-all duration-300 hover:border-blue-500/50 hover:bg-zinc-900/40 hover:shadow-lg hover:shadow-blue-500/5">
					<div>
						<div class="flex items-center justify-between mb-4">
							<div class="flex h-11 w-11 items-center justify-center rounded-lg bg-zinc-900/90 border border-zinc-800 text-blue-400 group-hover:scale-110 group-hover:text-blue-300 group-hover:border-blue-500/30 transition-all duration-300">
								<item.icon className="h-5 w-5" />
							</div>
							<span class="text-xs font-mono font-bold text-blue-400 bg-blue-950/60 border border-blue-500/30 px-2 py-0.5 rounded">{item.step}</span>
						</div>
						<h3 class="text-sm font-semibold text-white group-hover:text-blue-200 transition-colors mb-2">{item.title}</h3>
						<p class="text-xs text-zinc-400 leading-relaxed">{item.desc}</p>
					</div>
				</div>
			))}
		</div>

		<div class="mt-12 text-center">
			<a href="https://wa.me/6281385173654" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-lg bg-blue-600 px-6 py-3 text-xs sm:text-sm font-semibold text-white transition-all duration-200 hover:bg-blue-500 hover:shadow-lg hover:shadow-blue-600/25 active:scale-95 shadow">
				<MessageSquare className="h-4 w-4" />
				<span>Mulai Konsultasi & Order via WhatsApp</span>
			</a>
		</div>
	</div>
</section>