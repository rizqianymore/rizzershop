---
import { MessageSquare, ShieldCheck, Clock } from 'lucide-react';
---

<!-- Contact / Support Section -->
<section id="contact" class="flex min-h-screen w-full flex-col justify-center bg-black px-4 py-12 sm:px-6 relative overflow-hidden">
	<div class="mx-auto w-full max-w-4xl relative z-10">
		<div class="text-center max-w-2xl mx-auto mb-12">
			<div class="inline-flex items-center gap-1.5 rounded-full border border-blue-500/30 bg-blue-950/40 px-2.5 py-0.5 text-[11px] font-medium text-blue-400 mb-2.5">
				<span>Hubungi Dukungan</span>
			</div>
			<h2 class="text-2xl font-bold tracking-tight text-white sm:text-3xl bg-gradient-to-r from-white via-zinc-100 to-zinc-400 bg-clip-text text-transparent">Butuh Bantuan & Konsultasi?</h2>
			<p class="mt-2.5 text-xs sm:text-sm text-zinc-400">Tim teknis kami online dan siap membantu proses konfigurasi dan pemesanan Anda.</p>
		</div>

		<div class="max-w-md mx-auto w-full">
			<!-- WhatsApp Card -->
			<a href="https://wa.me/6281385173654" target="_blank" rel="noopener noreferrer" class="group flex flex-col items-center text-center p-8 rounded-2xl border border-zinc-800/80 bg-zinc-950/70 backdrop-blur-sm transition-all duration-300 hover:border-emerald-500/50 hover:bg-zinc-900/40 hover:shadow-xl hover:shadow-emerald-500/5">
				<div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 group-hover:scale-110 group-hover:bg-emerald-500/20 transition-all duration-300 mb-4">
					<MessageSquare className="h-8 w-8" />
				</div>
				<h3 class="text-lg font-bold text-white mb-1 group-hover:text-emerald-300 transition-colors">WhatsApp Support Resmi</h3>
				<p class="text-sm font-mono font-bold text-emerald-400 mb-1">+62 813-8517-3654</p>
				<p class="text-xs text-zinc-400 mb-5">Konsultasi gratis, respon instan langsung dengan admin teknis</p>
				<span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/30 px-3.5 py-1 text-[11px] font-medium text-emerald-400">
					<span class="inline-block h-1.5 w-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
					<span>Online 24/7 Fast Response</span>
				</span>
			</a>
		</div>

		<div class="mt-12 grid grid-cols-1 gap-4 sm:grid-cols-3">
			{[
				{ icon: Clock, title: 'Jam Operasional', desc: 'Senin - Minggu: 08:00 - 23:00 WIB' },
				{ icon: ShieldCheck, title: 'Garansi Layanan', desc: 'Replace cepat & garansi resmi sesuai paket' },
				{ icon: MessageSquare, title: 'Response Time', desc: 'Rata-rata tanggapan < 5 menit' },
			].map((item, i) => (
				<div data-astro-key={i} class="flex items-start gap-3.5 p-4 rounded-xl bg-zinc-950/60 border border-zinc-800/80 backdrop-blur-sm">
					<div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-zinc-900 text-blue-400 border border-zinc-800">
						<item.icon className="h-4 w-4" />
					</div>
					<div>
						<h4 class="text-sm font-semibold text-white">{item.title}</h4>
						<p class="text-xs text-zinc-400 mt-0.5">{item.desc}</p>
					</div>
				</div>
			))}
		</div>
	</div>
</section>