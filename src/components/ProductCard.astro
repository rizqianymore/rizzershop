---
import type { ProductItem } from '../data/products';
import { Badge } from './ui/badge';

interface Props extends ProductItem {}

const product = Astro.props;
const { title, description, category, price, period = '', tag, iconClass = 'fa-solid fa-server' } = product;
---

<div class="group relative flex flex-col justify-between rounded-xl border border-zinc-800/80 bg-zinc-950/70 p-5 backdrop-blur-sm transition-all duration-300 hover:border-blue-500/50 hover:bg-zinc-900/40 hover:shadow-lg hover:shadow-blue-500/5 min-h-[160px] h-full">
	<div class="flex-1">
		<!-- Card Header with Badges -->
		<div class="flex items-center justify-between mb-4">
			<Badge variant="outline" className="border-blue-500/30 bg-blue-950/40 text-blue-400 text-[10px] font-normal px-2 py-0.5 rounded">
				{category}
			</Badge>
			{tag && (
				<Badge className="bg-gradient-to-r from-blue-600 to-indigo-600 text-white text-[10px] font-medium px-2 py-0.5 rounded shadow-sm">
					{tag}
				</Badge>
			)}
		</div>

		<!-- Title & Icon -->
		<div class="flex items-center gap-3">
			<div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-zinc-900/90 border border-zinc-800 text-blue-400 group-hover:scale-105 group-hover:text-blue-300 group-hover:border-blue-500/30 transition-all duration-300">
				<i class={`${iconClass} text-lg`}></i>
			</div>
			<h3 class="text-sm font-semibold text-white group-hover:text-blue-300 transition-colors">
				{title}
			</h3>
		</div>

		<!-- Description -->
		{description && (
			<p class="mt-3 text-[11px] text-zinc-400 leading-relaxed line-clamp-2 group-hover:text-zinc-300">
				{description}
			</p>
		)}
	</div>

	<!-- Price & Order Link -->
	<div class="mt-6 flex items-center justify-between border-t border-zinc-900/90 pt-4">
		<div class="flex flex-col">
			{product.originalPrice && (
				<div class="flex items-center gap-1.5 mb-0.5">
					<span class="text-[11px] text-zinc-500 line-through font-medium">{product.originalPrice}</span>
					{product.discountPercent && (
						<span class="text-[9px] font-bold text-rose-400 bg-rose-950/70 border border-rose-500/30 px-1 py-0.2 rounded">-{product.discountPercent}</span>
					)}
				</div>
			)}
			<div class="flex flex-wrap items-baseline gap-1">
				<span class="text-base font-bold text-white tracking-tight group-hover:text-blue-200 transition-colors">{price}</span>
				{period && <span class="text-[11px] text-zinc-500 font-normal whitespace-nowrap">{period}</span>}
			</div>
		</div>

		<a
			href={`/produk/${product.id}`}
			class="inline-flex items-center gap-1.5 rounded-md bg-blue-600 px-3.5 py-1.5 text-xs font-semibold text-white transition-all duration-200 hover:bg-blue-500 hover:shadow-md hover:shadow-blue-600/20 active:scale-95 shadow"
		>
			<span>Beli</span>
		</a>
	</div>
</div>
