---
import Logo from './ui/Logo.astro';
---

<footer class="bg-black py-12 text-zinc-400">
	<div class="mx-auto max-w-6xl px-4 sm:px-6">
		<div class="grid grid-cols-1 gap-8 sm:grid-cols-2 md:grid-cols-4">
			<!-- Brand col -->
			<div class="space-y-3">
				<div class="flex items-center gap-2 text-lg font-bold text-white">
					<Logo size="sm" />
					<span>Rizzer<span class="text-blue-500">shop</span></span>
				</div>
				<p class="text-xs text-zinc-500 leading-relaxed">
					Pusat server VPS, RDP, dan akun premium dengan aktivasi otomatis dan bergaransi penuh.
				</p>
			</div>

			<!-- Links: Belanja (no uppercase) -->
			<div>
				<h4 class="text-xs font-medium text-zinc-200">Belanja</h4>
				<ul class="mt-3 space-y-2 text-xs">
					<li><a href="#products" class="hover:text-blue-400 transition-colors">Semua Kategori</a></li>
					<li><a href="#products" class="hover:text-blue-400 transition-colors">Produk Terbaru</a></li>
					<li><a href="#products" class="hover:text-blue-400 transition-colors">Promo & Diskon</a></li>
				</ul>
			</div>

			<!-- Links: Bantuan (no uppercase) -->
			<div>
				<h4 class="text-xs font-medium text-zinc-200">Bantuan</h4>
				<ul class="mt-3 space-y-2 text-xs">
					<li><a href="#how-it-works" class="hover:text-blue-400 transition-colors">Cara Pemesanan</a></li>
					<li><a href="#faq" class="hover:text-blue-400 transition-colors">FAQ & Pertanyaan</a></li>
					<li><a href="#contact" class="hover:text-blue-400 transition-colors">Hubungi Dukungan</a></li>
				</ul>
			</div>

			<!-- Social Icons: Ikuti Kami (no uppercase) -->
			<div>
				<h4 class="text-xs font-medium text-zinc-200">Ikuti Kami</h4>
				<div class="mt-3 flex items-center gap-3">
					<a href="#" class="flex h-8 w-8 items-center justify-center rounded bg-zinc-900 text-zinc-400 hover:bg-zinc-850 hover:text-blue-400 transition" aria-label="Instagram">
						<i class="fa-brands fa-instagram text-sm"></i>
					</a>
					<a href="#" class="flex h-8 w-8 items-center justify-center rounded bg-zinc-900 text-zinc-400 hover:bg-zinc-850 hover:text-blue-400 transition" aria-label="Twitter">
						<i class="fa-brands fa-twitter text-sm"></i>
					</a>
					<a href="#" class="flex h-8 w-8 items-center justify-center rounded bg-zinc-900 text-zinc-400 hover:bg-zinc-850 hover:text-blue-400 transition" aria-label="Telegram">
						<i class="fa-brands fa-telegram text-sm"></i>
					</a>
				</div>
			</div>
		</div>

		<div class="mt-10 border-t border-zinc-900 pt-6 text-center text-xs text-zinc-600">
			&copy; {new Date().getFullYear()} Rizzershop. All rights reserved.
		</div>
	</div>
</footer>
