---
interface Props {
  size?: 'sm' | 'md' | 'lg' | 'xl';
  class?: string;
}

const { size = 'md', class: className = '' } = Astro.props;

const sizeMap = {
  sm: 'h-6 w-6',
  md: 'h-8 w-8',
  lg: 'h-10 w-10',
  xl: 'h-14 w-14'
};
---

<img
  src="/favicon.svg"
  alt="Rizzershop Logo"
  class={`inline-block object-contain rounded-md shadow-sm select-none ${sizeMap[size]} ${className}`}
  width="32"
  height="32"
  loading="eager"
/>