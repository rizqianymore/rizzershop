---
import { Server, ShieldCheck, Zap, ArrowRight } from 'lucide-react';
import HeroTitle from './HeroTitle';
import { FlickeringGrid } from './ui/flickering-grid';
---

<!-- 1 Window Fullscreen Hero Section -->
<section class="relative flex min-h-[calc(100vh-4rem)] w-full flex-col items-center justify-center overflow-hidden bg-black px-4 py-8 sm:px-6">
	<!-- Background Flickering Grid -->
	<div class="absolute inset-0 h-full w-full pointer-events-none z-0">
		<FlickeringGrid
			client:load
			className="h-full w-full"
			squareSize={4}
			gridGap={6}
			color="#6B7280"
			maxOpacity={0.5}
			flickerChance={0.1}
		/>
	</div>

	<!-- Center Content -->
	<div class="relative z-10 mx-auto max-w-2xl text-center">
		<!-- Mini Title / Badge (No uppercase) -->
		<div class="inline-flex items-center gap-1.5 rounded-full border border-blue-500/30 bg-blue-950/40 px-2.5 py-0.5 text-[11px] font-medium text-blue-400 mb-4 normal-case">
			<Zap className="h-3 w-3" />
			<span>Aktivasi instan & bergaransi</span>
		</div>

		<!-- Title with Sparkles Effect -->
		<h1 class="mx-auto flex justify-center">
			<HeroTitle client:load />
		</h1>

		<p class="mx-auto mt-3 max-w-lg text-xs sm:text-sm text-zinc-400 leading-relaxed">
			Dapatkan server VPS performa tinggi, RDP, lisensi software, dan akun premium dengan harga bersahabat serta proses serba otomatis.
		</p>

		<div class="mt-6 flex flex-wrap items-center justify-center gap-3">
			<a
				href="/produk"
				class="inline-flex items-center gap-2 rounded-md bg-blue-600 px-4 py-2 text-xs sm:text-sm font-medium text-white transition hover:bg-blue-500 shadow-sm active:scale-95"
			>
				<Server className="h-3.5 w-3.5" />
				<span>Lihat Katalog Lengkap</span>
				<ArrowRight className="h-3.5 w-3.5" />
			</a>
			<a
				href="#categories"
				class="inline-flex items-center gap-2 rounded-md border border-zinc-800 bg-zinc-950 px-4 py-2 text-xs sm:text-sm font-medium text-zinc-300 transition hover:border-zinc-700 hover:text-white active:scale-95"
			>
				<ShieldCheck className="h-3.5 w-3.5 text-blue-400" />
				<span>Garansi Layanan</span>
			</a>
		</div>
	</div>
</section>
