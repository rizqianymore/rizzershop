---
import TestimonialsMarquee from './TestimonialsMarquee';
---

<section id="testimonials" class="flex min-h-screen w-full flex-col justify-center bg-black px-4 py-12 sm:px-6">
	<div class="mx-auto w-full max-w-6xl">
		<div class="text-center max-w-2xl mx-auto mb-8">
			<div class="text-xs font-medium text-blue-500 mb-1">Testimoni Pelanggan</div>
			<h2 class="text-2xl font-bold tracking-tight text-white sm:text-3xl">Kata Mereka Tentang RizzerShop</h2>
			<p class="mt-2 text-xs sm:text-sm text-zinc-400">
				Ratusan developer, sysadmin, dan digital enthusiast telah mempercayakan kebutuhan server dan akun premium mereka.
			</p>
		</div>

		<TestimonialsMarquee client:visible />
	</div>
</section>
